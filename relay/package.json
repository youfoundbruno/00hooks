    "seal-interop": "node scripts/seal-interop.ts --fixture",
    "setup": "node scripts/setup.mjs",
    "test:setup": "node --test scripts/setup.nodetest.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "dependencies": {
    "@hpke/chacha20poly1305": "1.8.0",
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0"
  }
