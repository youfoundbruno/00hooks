// The 00hooks relay: one Worker and two Durable Object classes, each one object per account: the
// webhook log (AccountObject) and the phone links' mailbox and sockets (PhoneObject, PROTOCOL §10).
// Self-hosting: copy this file to the gitignored `wrangler.deploy.jsonc`, put your D1 database's id
// and your own rate-limit namespace ids there, set the secrets listed in `.dev.vars.example` with
// `wrangler secret put`, and deploy with `-c wrangler.deploy.jsonc`; `pnpm --filter ./relay setup` does
// all of that. See README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "00hooks-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  // Invocation logs are off: they record each request's URL, and Meta's endpoint check carries the
  // hook's verify token in its query string (`hub.verify_token`). The relay's own logs never do.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },

  // Once a day, D1 rows past their use (expired enrolments and pairings, old failure counts, long
  // dead API keys) are deleted (src/prune.ts).
  "triggers": { "crons": ["17 4 * * *"] },

  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT", "class_name": "AccountObject" },
      { "name": "PHONE", "class_name": "PhoneObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountObject"] },
    { "tag": "v2", "new_sqlite_classes": ["PhoneObject"] }
  ],

  // Accounts, devices, hooks (with their sealed secrets), enrolments, and the routing from a hook
  // id to its account. Replace the id with your own database's (`wrangler d1 create 00hooks`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "00hooks",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Cheap shedding at the edge (PROTOCOL §2, §4). The relay refuses with 503 when one is missing.
  // HOOK_LIMIT: 60 deliveries per 10 s per hook. RECEIVE_IP_LIMIT: 600 deliveries per 10 s per
  // client address (IPv6 by /64), checked before the hook lookup; raise it for a relay that serves
  // many people, since a big provider sends every one of their hooks from a few addresses.
  // REDEEM_IP_LIMIT and REDEEM_GLOBAL_LIMIT: enrolment redemptions per minute, per address and in all.
  // PAIR_IP_LIMIT and PAIR_GLOBAL_LIMIT: phone pairing attempts (PROTOCOL §10) per minute, per
  // address and in all.
  // SIGNUP_IP_LIMIT: account creations per minute per address. API_IP_LIMIT: management requests
  // (`/v1/*` except `/v1/info`) per 10 s per address, checked before any database read.
  // Rate Limiting counts per Cloudflare location, so even the "global" limits are per location.
  // Each namespace_id must be unique within your Cloudflare account.
  "ratelimits": [
    { "name": "HOOK_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 10 } },
    { "name": "RECEIVE_IP_LIMIT", "namespace_id": "1002", "simple": { "limit": 600, "period": 10 } },
    { "name": "REDEEM_IP_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "REDEEM_GLOBAL_LIMIT", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } },
    { "name": "PAIR_IP_LIMIT", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
    { "name": "SIGNUP_IP_LIMIT", "namespace_id": "1006", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_IP_LIMIT", "namespace_id": "1007", "simple": { "limit": 300, "period": 10 } },
    { "name": "PAIR_GLOBAL_LIMIT", "namespace_id": "1008", "simple": { "limit": 120, "period": 60 } }
  ],

  // ACCOUNT_MAX_EVENTS and ACCOUNT_MAX_BYTES: what one account's log may hold before deliveries are
  // refused with 429 `quota` (events waiting for an acknowledgement; bytes of bodies and headers).
  // Each hook may hold only a share of it, and the screen's hold has its own quota (src/env.d.ts
  // lists the optional settings). Signups are refused unless SIGNUP_TOKEN is set as a secret, or
  // OPEN_SIGNUP is "1".
  "vars": { "RETENTION_DAYS": "7", "ACCOUNT_MAX_EVENTS": "10000", "ACCOUNT_MAX_BYTES": "268435456" }
}
